// Social network — self refs, junction tables, enum columns
Enum visibility {
  public
  friends
  private
}

Enum reaction_kind {
  like
  love
  laugh
}

Table profiles {
  id bigint [pk]
  username varchar(30) [unique, not null]
  visibility visibility [default: 'public']
  avatar_url varchar
}

Table follows {
  follower_id bigint
  followee_id bigint
  since timestamp [default: `now()`]
  indexes {
    (follower_id, followee_id) [pk]
    (followee_id, since)
  }
}

Table posts {
  id bigint [pk, increment]
  author_id bigint [not null, ref: > profiles.id]
  reply_to bigint [ref: > posts.id]
  body varchar(500)
  visibility visibility [default: 'public']
}

Table reactions {
  post_id bigint [ref: > posts.id]
  profile_id bigint [ref: > profiles.id]
  kind reaction_kind [not null]
  indexes {
    (post_id, profile_id) [pk]
  }
}

Ref: follows.follower_id > profiles.id
Ref: follows.followee_id > profiles.id
