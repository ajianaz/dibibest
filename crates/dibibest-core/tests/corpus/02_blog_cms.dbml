// Blog / CMS
Table authors {
  id int [pk, increment]
  handle varchar(40) [unique, not null]
  bio text [note: 'Markdown allowed']
}

Table posts {
  id int [pk, increment]
  author_id int [not null]
  slug varchar(200) [unique, not null]
  title varchar [not null]
  body text
  published boolean [default: false]
  published_at timestamp [null]
  indexes {
    (author_id, published_at)
    (`published_at DESC`) [name: 'posts_recent']
  }
}

Table comments {
  id int [pk, increment]
  post_id int [not null]
  author_id int
  parent_id int
  body text [not null, note: 'Escaped \' quote and // not a comment']
}

Table tags {
  id int [pk, increment]
  label varchar(60) [unique]
}

Table post_tags {
  post_id int
  tag_id int
  indexes {
    (post_id, tag_id) [pk]
  }
}

Ref: posts.author_id > authors.id
Ref: comments.post_id > posts.id
Ref: comments.author_id > authors.id
Ref: comments.parent_id > comments.id
Ref: post_tags.post_id > posts.id
Ref: post_tags.tag_id > tags.id
